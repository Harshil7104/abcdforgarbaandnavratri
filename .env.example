# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Replace with your Atlas cluster URL)
# Note: If password contains special characters like '@', URL-encode them (e.g. '@' -> '%40')
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/garba-partner?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a 32+ character random secret)
JWT_SECRET=your_super_secret_jwt_key_garba_2026

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# WhatsApp Business / Notification Configuration (Optional for production)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Cloud Keep-Alive Setting (Render Free Tier)
DISABLE_KEEP_ALIVE=false
